# Path where uploaded photos are stored.
# On macOS external drives are typically at /Volumes/DriveName
# On Linux: /mnt/DriveName or /media/user/DriveName
UPLOADS_DIR=/Volumes/MyDrive/photos

# Optional: move the database off the project directory too
# DB_PATH=/Volumes/MyDrive/photos.db

# Server port (default: 3001)
# PORT=3001

# Auth — set JWT_SECRET to enable user accounts. Each person registers their
# own username + password in the app; this secret signs their login tokens.
# Use a long random string, e.g. `openssl rand -hex 32`.
# If left unset, auth is DISABLED and all data is public (LAN-only use).
# JWT_SECRET=a-long-random-secret-string
